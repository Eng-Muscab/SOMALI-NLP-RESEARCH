# Virtual environments
.venv/
venv/
env/
ENV/

# Node modules and frontend cache
node_modules/
web/frontend/.vite/
web/frontend/node_modules/

# Claude Code memory (local only)
.claude/

# Upload temp directory
web/backend/uploads/

# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE and editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS-generated files
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# Logs & temp files
*.log
.tmp/
temp/
~$*.docx
~$*.xlsx
~*.tmp

# Training logs (TensorBoard, etc.)
models/transformers/training_logs/
models/deep_learning/training_logs/
experiments/*/models/transformers/training_logs/
experiments/*/models/deep_learning/training_logs/

# Intermediate/heavy training checkpoints (e.g. checkpoint-500, checkpoint-1000, and run/)
# These directories contain massive optimizer states, gradients, and intermediate weights
# which are only needed during the active training process, not to use the final models.
models/transformers/checkpoints/*/run/
models/transformers/checkpoints/*/checkpoint-*/
models/deep_learning/checkpoints/*/checkpoint-*/
experiments/*/models/transformers/*/run/
experiments/*/models/transformers/*/checkpoint-*/

# BUT do NOT ignore the final/best trained models
# (These will be tracked via Git LFS as configured in .gitattributes)
# e.g., the "best" directories for transformers, traditional ML joblibs, and DL keras/embedding models.
!models/transformers/checkpoints/*/best/
!experiments/*/models/**/best/

# ── Deployment hygiene ──────────────────────────────────────────────────────
# Secrets never belong in a public repository. `.env.example` documents the
# shape; the real file is written on the server and stays there.
web/backend/.env

# Trained weights are not source. Git LFS on the free tier allows 1 GB and this
# project carries 7.7 GB, so the models are transferred to the server directly
# (see DEPLOY.md) and git holds only the code that loads them.
experiments/*/models/
experiments/*/data/*.joblib
experiments/*/data/*.model
experiments/*/data/*.csv
models/*.joblib
# Superseded weights kept from before the 483-stopword retrain.
experiments/*/_pre_483_models/
experiments/*/data/_pre_483_backup/
experiments/*/data/*.pkl

# The built frontend is generated by `npm run build`; deploy/setup.sh runs it on
# the server, so committing the output only produces churn in hashed filenames.
web/frontend/dist/
